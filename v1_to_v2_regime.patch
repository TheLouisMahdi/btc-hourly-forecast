+def _expected_calibration_error(y_true: np.ndarray, probability: np.ndarray, bins: int = 10) -> float:
+    edges = np.linspace(0.0, 1.0, bins + 1)
+    total = len(y_true)
+    error = 0.0
+    for idx in range(bins):
+        if idx == bins - 1:
+            mask = (probability >= edges[idx]) & (probability <= edges[idx + 1])
